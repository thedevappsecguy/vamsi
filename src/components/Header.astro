---
import SearchModal from "./SearchModal.astro";
import { SITE_TITLE, withBase } from "../consts";

const currentPath = Astro.url.pathname.replace(/\/$/, "");
const navItems = [
  { href: withBase(""), label: "Home" },
  { href: withBase("notes/"), label: "Notes" },
  { href: withBase("tags/"), label: "Tags" },
];

function isActive(href: string) {
  const normalized = href.replace(/\/$/, "");
  if (normalized === withBase("").replace(/\/$/, "")) return currentPath === normalized;
  return currentPath === normalized || currentPath.startsWith(`${normalized}/`);
}
---

<header class="site-header">
  <nav class="shell site-nav" aria-label="Primary navigation">
    <a class="brand" href={withBase("")} aria-label="Vamsi home">
      <span class="brand-mark">V</span>
      <span>{SITE_TITLE}</span>
    </a>

    <div class="nav-links">
      {navItems.map((item) => (
        <a href={item.href} class:list={["nav-link", { active: isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </div>

    <div class="nav-actions">
      <SearchModal />
      <button id="theme-toggle" class="icon-button" type="button" aria-label="Toggle theme" title="Toggle theme">
        <svg class="sun-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <svg class="moon-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.5 6.5 0 0 0 21 12.8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  const themeToggle = document.getElementById("theme-toggle");
  const storageKey = "vamsi-theme";

  function applyTheme(nextTheme: "light" | "dark") {
    document.documentElement.classList.toggle("dark", nextTheme === "dark");
    localStorage.setItem(storageKey, nextTheme);
  }

  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.contains("dark");
    applyTheme(isDark ? "light" : "dark");
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border-color);
    background: color-mix(in srgb, var(--bg-primary) 88%, transparent);
    backdrop-filter: blur(16px);
  }

  .site-nav {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    min-height: 68px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text-primary);
    font-weight: 800;
  }

  .brand:hover {
    color: var(--text-primary);
  }

  .brand-mark {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--surface);
    color: var(--accent-strong);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1;
    box-shadow: var(--shadow);
  }

  .nav-links {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
  }

  .nav-link {
    position: relative;
    padding: 0.4rem 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text-primary);
  }

  .nav-link.active::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    border-radius: 999px;
    background: var(--accent);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .icon-button {
    display: inline-grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
  }

  .icon-button:hover {
    color: var(--accent-strong);
    border-color: color-mix(in srgb, var(--accent) 42%, var(--border-color));
  }

  .moon-icon {
    display: none;
  }

  html.dark .sun-icon {
    display: none;
  }

  html.dark .moon-icon {
    display: block;
  }

  @media (max-width: 760px) {
    .site-nav {
      grid-template-columns: 1fr auto;
      gap: 0.75rem;
      padding-block: 0.75rem;
    }

    .nav-links {
      grid-column: 1 / -1;
      justify-content: flex-start;
      gap: 1rem;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .nav-links::-webkit-scrollbar {
      display: none;
    }
  }
</style>
