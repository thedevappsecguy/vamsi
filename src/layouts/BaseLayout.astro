---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  date?: Date | string;
  type?: "website" | "article";
}

const { title, description, image, date, type } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} date={date} type={type} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <Footer />
  </body>
</html>
