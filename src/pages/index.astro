---
import { getCollection } from "astro:content";
import { BadgeCheck, BriefcaseBusiness, Code } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  AUTHOR_LOCATION,
  AUTHOR_NAME,
  AUTHOR_TITLE,
  SITE_DESCRIPTION,
  SITE_TITLE,
  withBase,
} from "../consts";
import { focusAreas, focusYear, profileIntro, profilePoints, projects, socialLinks } from "../data/portfolio";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });

const profileIcons = {
  GitHub: Code,
  LinkedIn: BriefcaseBusiness,
  Credly: BadgeCheck,
};
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow">{AUTHOR_LOCATION}</p>
        <h1 class="display-heading">{AUTHOR_NAME}</h1>
        <p class="role">{AUTHOR_TITLE}</p>
        <div class="hero-actions">
          <a class="primary-link" href="#projects">Projects</a>
          <a class="secondary-link" href={withBase("notes/")}>Notes</a>
        </div>
      </div>

      <aside class="signal-panel" aria-label="Current focus">
        <div class="panel-head">
          <span>Focus</span>
          <span>{focusYear}</span>
        </div>
        <ul>
          {focusAreas.map((area) => <li>{area}</li>)}
        </ul>
      </aside>
    </section>

    <section class="profile-band">
      <div class="shell profile-grid">
        <div class="profile-intro">
          <p class="eyebrow">Profile</p>
          <h2 class="section-title">Product security that scales with engineering.</h2>
          <p>{profileIntro}</p>
        </div>
        <div class="profile-summary">
          <ul>
            {profilePoints.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="shell link-strip" aria-label="Profile links">
      {socialLinks.map((link) => {
        const Icon = profileIcons[link.label as keyof typeof profileIcons];
        return (
          <a class="profile-link" href={link.href} target="_blank" rel="noopener noreferrer">
            <span class="profile-icon" aria-hidden="true">
              <Icon size={20} stroke-width={2.25} />
            </span>
            <span>
              <strong>{link.label}</strong>
              <small>{link.sub}</small>
            </span>
          </a>
        );
      })}
    </section>

    <section id="projects" class="shell projects-section">
      <div class="section-head">
        <div>
          <p class="eyebrow">Open Source</p>
          <h2 class="section-title">Tools</h2>
        </div>
      </div>

      <div class="project-grid">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-topline">
              <span>{project.kind}</span>
              <code>{project.install}</code>
            </div>
            <h3>{project.name}</h3>
            <p>{project.blurb}</p>
            <ul class="pill-list">
              {project.tags.map((tag) => <li class="pill">{tag}</li>)}
            </ul>
            <div class="project-links">
              {project.links.map((link) => (
                <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="notes-band">
      <div class="shell notes-grid">
        <div class="notes-intro">
          <p class="eyebrow">Notes</p>
          <h2 class="section-title">Recent notes</h2>
          <a class="text-link notes-archive-link" href={withBase("notes/")}>View all notes</a>
        </div>

        <ol class="notes-list">
          {notes.slice(0, 3).map((post) => (
            <li>
              <a href={withBase(`notes/${post.id}/`)}>
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <span>
                  <strong>{post.data.title}</strong>
                  <small>{post.data.summary}</small>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
    gap: 4rem;
    align-items: end;
    padding: clamp(3rem, 7vw, 5.5rem) 0 3.5rem;
  }

  .hero-copy .display-heading {
    margin: 0.35rem 0 0;
  }

  .role {
    margin: 1.6rem 0 0;
    color: var(--text-primary);
    font-size: clamp(1.15rem, 2vw, 1.65rem);
    font-weight: 800;
    line-height: 1.2;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .primary-link,
  .secondary-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.7rem;
    border-radius: 8px;
    font-weight: 800;
    padding: 0.65rem 1rem;
  }

  .primary-link {
    background: var(--text-primary);
    color: var(--bg-primary);
  }

  .primary-link:hover {
    color: var(--bg-primary);
    background: var(--accent-strong);
  }

  .secondary-link {
    border: 1px solid var(--border-color);
    background: var(--surface);
    color: var(--text-primary);
  }

  .signal-panel {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-secondary);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.8rem 0.95rem;
    text-transform: uppercase;
  }

  .signal-panel ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .signal-panel li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.4rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-primary);
    font-weight: 800;
    padding: 0 0.95rem;
  }

  .signal-panel li:last-child {
    border-bottom: 0;
  }

  .signal-panel li::after {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .profile-band,
  .notes-band {
    border-block: 1px solid var(--border-color);
    background: color-mix(in srgb, var(--surface) 62%, transparent);
  }

  .profile-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 4rem;
    padding: 4rem 0;
  }

  .profile-intro {
    display: grid;
    align-content: start;
    gap: 0.9rem;
  }

  .profile-intro p {
    max-width: 30rem;
    margin: 0;
    color: var(--text-muted);
    font-size: 1.04rem;
  }

  .profile-summary {
    display: grid;
    border-top: 1px solid var(--border-color);
    padding-top: 1.2rem;
  }

  .profile-summary ul {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .profile-summary li {
    color: var(--text-secondary);
  }

  .profile-summary li::before {
    content: "";
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 0.12em;
  }

  .link-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding: 2rem 0 0;
  }

  .profile-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 4.2rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--surface);
    padding: 0.85rem;
  }

  .profile-link:hover {
    border-color: color-mix(in srgb, var(--accent) 42%, var(--border-color));
    color: var(--text-primary);
  }

  .profile-icon {
    display: inline-grid;
    width: 2.4rem;
    height: 2.4rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--bg-secondary);
    color: var(--accent-strong);
  }

  .profile-link span:not(.profile-icon) {
    display: grid;
    gap: 0.05rem;
  }

  .profile-link strong {
    color: var(--text-primary);
  }

  .profile-link small {
    color: var(--text-muted);
  }

  .projects-section {
    padding: 5rem 0;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .project-card {
    display: flex;
    min-height: 27rem;
    flex-direction: column;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--surface);
    padding: 1.2rem;
  }

  .project-topline {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .project-topline span {
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-topline code {
    overflow-wrap: anywhere;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    background: var(--bg-secondary);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.45rem 0.5rem;
  }

  .project-card h3 {
    margin: 0 0 0.65rem;
    color: var(--text-primary);
    font-size: 1.4rem;
  }

  .project-card p {
    margin: 0 0 1rem;
    color: var(--text-secondary);
  }

  .project-links {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.4rem;
  }

  .notes-grid {
    display: grid;
    grid-template-columns: minmax(220px, 0.45fr) minmax(0, 1.55fr);
    gap: 4rem;
    align-items: start;
    padding: 4rem 0;
  }

  .notes-list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notes-archive-link {
    margin-top: 1rem;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .profile-link,
    .project-card {
      transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    }

    .profile-link:hover,
    .project-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow);
    }
  }

  .notes-list li + li {
    border-top: 1px solid var(--border-color);
  }

  .notes-list {
    border-bottom: 1px solid var(--border-color);
  }

  .notes-list a {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
  }

  .notes-list time {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .notes-list span {
    display: grid;
    gap: 0.35rem;
  }

  .notes-list strong {
    color: var(--text-primary);
    font-size: 1.08rem;
  }

  .notes-list small {
    color: var(--text-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  @media (max-width: 920px) {
    .hero,
    .profile-grid,
    .notes-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .project-grid,
    .link-strip {
      grid-template-columns: 1fr;
    }

    .project-card {
      min-height: auto;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 3rem;
    }

    .notes-list a {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
