{
  "name": "vamsi-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": "v24.21.0",
    "npm": "12.2.0"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist --output-path dist/pagefind --force-language en",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "astro": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "npm run check && npm run build && npm run test:e2e",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@lucide/astro": "1.48.0",
    "astro": "7.3.5",
    "pagefind": "1.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "@playwright/test": "1.63.0",
    "cross-env": "10.1.0",
    "rehype-external-links": "3.0.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "vite": "8.3.1"
  }
}
