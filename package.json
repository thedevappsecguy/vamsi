{
  "name": "vamsi-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^24.11.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist --output-path dist/pagefind --force-language en",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "astro": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "npm run check && npm run build && npm run test:e2e",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@astrojs/mdx": "5.0.6",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@lucide/astro": "1.25.0",
    "astro": "6.4.8",
    "pagefind": "1.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@playwright/test": "1.61.1",
    "cross-env": "10.1.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "js-yaml": "4.3.0",
    "vite": "7.3.6"
  }
}
